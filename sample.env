APP_NAME=Async-Task-Queue
APP_VERSION=1.0.0
APP_DESCRIPTION=An asynchronous task queue microservice built with FastAPI and Celery.

APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT = 8000

# Billing (per hour, in INR). Snapshotted into each ticket on issue.
RATE_CAR=100
RATE_BIKE=50
RATE_TRUCK=300
# Free if total parking duration is below this many minutes.
GRACE_PERIOD_MINUTES=15

# Redis (local default)
REDIS_HOST=127.0.0.1 # my-redis.neoll0.ng.xxxx.aps1.cache.amazonaws.com
REDIS_PORT=6379
REDIS_DB=0

# AWS ElastiCache for Redis (uncomment + fill in for production)
# REDIS_HOST=async-task-queue-redis.abc123.ng.0001.use1.cache.amazonaws.com
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_AUTH_TOKEN=your-auth-token-here    # only if you set one in ElastiCache
# REDIS_SSL=true                           # only if encryption-in-transit is enabled

# Total number of parking slots in the system. Snapshotted into each ticket on issue.
TOTAL_SLOTS=10
TOTAL_FLOORS=1
MAX_TICKET_ISSUE_RETRIES = 5